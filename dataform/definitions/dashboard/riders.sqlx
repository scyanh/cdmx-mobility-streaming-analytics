config {
  disabled: dataform.projectConfig.vars.include_history !== "true",
  type: "view",
  schema: "mobility_dashboard",
  description: "Trips by rider age group and gender, as published by ECOBICI (no individual riders: each row is a trip)."
}

SELECT
  CASE
    WHEN age IS NULL THEN 'Not stated'
    WHEN age < 25 THEN '16-24'
    WHEN age < 35 THEN '25-34'
    WHEN age < 45 THEN '35-44'
    WHEN age < 55 THEN '45-54'
    WHEN age < 65 THEN '55-64'
    ELSE '65+'
  END AS age_group,
  gender,
  COUNT(*) AS trips,
  ROUND(APPROX_QUANTILES(duration_min, 2)[OFFSET(1)], 1) AS median_trip_minutes
FROM ${ref("trips")}
GROUP BY 1, 2
